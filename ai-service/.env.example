# Server
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Security — must match INTERNAL_SERVICE_KEY in api/.env (generate: openssl rand -hex 32)
INTERNAL_SERVICE_KEY=change_me_to_a_random_32_plus_char_string

# LLM — free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

# Agent loop limits
AGENT_MAX_STEPS=5
AGENT_TURN_MAX_SECONDS=45
MAX_HISTORY_MESSAGES=12

# Api gateway base URL (WITHOUT /api) — tools call its /internal/* routes
API_GATEWAY_URL=http://127.0.0.1:5010

# RAG — CONTENT_DIR defaults to ../content (the repo's shared content folder)
# CONTENT_DIR=../content
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=5
