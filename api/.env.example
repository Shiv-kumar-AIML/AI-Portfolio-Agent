# Server
PORT=5010
NODE_ENV=development
# Comma-separated browser origins allowed to call the API directly (the Vite dev server).
# In production the frontend is served through nginx on the same origin, so this rarely matters.
ALLOWED_ORIGINS=http://localhost:5173
ENABLE_API_DOCS=true

# Database (docker-compose.local.yml publishes Postgres on 5434)
DATABASE_URL=postgresql://postgres:password@localhost:5434/portfolio

# AI service — base URL WITHOUT /internal
AI_SERVICE_URL=http://127.0.0.1:8000
# Must match INTERNAL_SERVICE_KEY in ai-service/.env (generate: openssl rand -hex 32)
INTERNAL_SERVICE_KEY=change_me_to_a_random_32_plus_char_string

# Owner admin routes (/api/admin/*) — leave empty to disable them entirely (generate: openssl rand -hex 32)
ADMIN_TOKEN=

# Content — defaults to ../content (the repo's shared content folder)
# CONTENT_DIR=../content

# GitHub (optional) — raises the API rate limit from 60/h; a fine-grained token with no scopes is enough
GITHUB_TOKEN=

# New-message notifications (optional) — a Discord or Slack incoming-webhook URL
NOTIFY_WEBHOOK_URL=

# Rate limits per IP
CHAT_RATE_LIMIT_PER_MINUTE=15
CHAT_RATE_LIMIT_PER_DAY=150
CONTACT_RATE_LIMIT_PER_HOUR=5
