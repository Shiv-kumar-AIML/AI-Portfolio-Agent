# Must match INTERNAL_SERVICE_KEY in api/.env — only the api may open sessions.
INTERNAL_SERVICE_KEY=change_me_to_a_random_32_plus_char_string

# Where it listens (the api's BROWSER_SERVICE_URL points here, e.g. ws://127.0.0.1:8090)
PORT=8090
HOST=127.0.0.1

# Content — defaults to ../content; the allowlist reads the links in profile.json
# CONTENT_DIR=../content

# Each session is a Chromium context (~100-300 MB RAM). Visitors past the cap get the previews.
BROWSER_MAX_SESSIONS=3
BROWSER_MAX_TABS=4
BROWSER_IDLE_MS=300000
BROWSER_MAX_SESSION_MS=1200000
BROWSER_JPEG_QUALITY=85
# Render scale (pixel ratio) of the streamed frames: 2 keeps text sharp, 1 halves the bandwidth
BROWSER_SCALE=2

# Hosts the browser may open besides GitHub, LinkedIn and the profile's own links (comma-separated)
BROWSER_EXTRA_HOSTS=
