{
  "name": "portfolio-browser",
  "version": "1.0.0",
  "description": "Remote Chromium for the mini-OS browser: streams screen frames over a WebSocket and replays the visitor's input",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
